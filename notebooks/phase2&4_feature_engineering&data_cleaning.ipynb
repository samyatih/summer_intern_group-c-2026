    "\n",
    "plt.title(\"Bird Speed Distribution (0–5 m/s)\", fontsize=14, fontweight='bold')\n",
    "plt.xlabel(\"Speed (m/s)\", fontsize=12)\n",
    "plt.ylabel(\"Frequency\", fontsize=12)\n",
    "plt.legend()\n",
    "\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "    \"figures/Figure_2_Bird_Speed_Distribution_0_5ms.png\",\n",
    "    dpi=300,\n",
    "    bbox_inches=\"tight\"\n",
